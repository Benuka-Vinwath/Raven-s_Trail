PORT=4000
NODE_ENV=development

# PostgreSQL connection
DATABASE_URL=postgres://ravenstrail:ravenstrail@localhost:5432/ravenstrail

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed origin for the frontend (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173

# AI budget planner (free key from https://aistudio.google.com/apikey). Leave empty to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
